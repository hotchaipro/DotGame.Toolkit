<?xml version="1.0" encoding="utf-8"?>
<!--
    Properties pane (browse object) for SpriteFontContent items.
    See ContentPipeline.TextureContent.BrowseObject.xaml in the framework
    pipeline for why each rule lives in its own file.
    Registered by ContentPipeline.Toolkit.targets.
-->
<Rule Name="SpriteFontContent"
      DisplayName="Font Content"
      PageTemplate="generic"
      Description="Font file (TTF/OTF) built into a sprite font (.spritefont + atlas pages) by the content pipeline."
      xmlns="http://schemas.microsoft.com/build/2009/properties">

  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="False" ItemType="SpriteFontContent" />
  </Rule.DataSource>

  <Rule.Categories>
    <Category Name="ContentPipeline" DisplayName="Content Pipeline" />
    <Category Name="Advanced" DisplayName="Advanced" />
    <Category Name="Misc" DisplayName="Misc" />
  </Rule.Categories>

  <DynamicEnumProperty Name="{}{ItemType}"
                       DisplayName="Build Action"
                       Category="Advanced"
                       Description="How the file relates to the build and deployment processes."
                       EnumProvider="ItemTypes" />

  <StringProperty Name="Name"
                  DisplayName="Name"
                  Description="Output file name (default: the font file name). Required when one font file feeds several outputs, e.g. 'basefont.zh'."
                  Category="ContentPipeline" />

  <StringProperty Name="Size"
                  DisplayName="Size"
                  Description="Atlas glyph size in pixels per em, a number from 4 to 512 that may have a fraction (default 32). For distance-field formats this is the sampling resolution, not the display size; text scales freely. For Bitmap this is the display size."
                  Category="ContentPipeline" />

  <StringProperty Name="Charset"
                  DisplayName="Charset"
                  Description="Literal characters to include. Unioned with CharsetFile. Default when both are empty: printable ASCII."
                  Category="ContentPipeline" />

  <StringProperty Name="CharsetFile"
                  DisplayName="Charset File"
                  Description="Semicolon-separated UTF-8 text files whose characters are included."
                  Category="ContentPipeline" />

  <StringProperty Name="Fallback"
                  DisplayName="Fallback"
                  Description="Semicolon-separated font files, in preference order, that supply characters missing from the primary font."
                  Category="ContentPipeline" />

  <EnumProperty Name="GlyphFormat"
                DisplayName="Glyph Format"
                Description="How glyphs are stored in the atlas. Mtsdf (default) scales freely with sharp corners and draws every text effect; Msdf is about 30% smaller but can only draw sharp, unlimited outline corners and only small softness; Sdf is single-channel and rounds every corner; Bitmap is hinted coverage for pixel-exact text at Size, with no effects."
                Category="ContentPipeline">
    <EnumValue Name="Mtsdf" DisplayName="Mtsdf" IsDefault="true" />
    <EnumValue Name="Msdf" DisplayName="Msdf" />
    <EnumValue Name="Sdf" DisplayName="Sdf" />
    <EnumValue Name="Bitmap" DisplayName="Bitmap" />
  </EnumProperty>

  <IntProperty Name="PxRange"
               DisplayName="Px Range"
               Description="Distance range width in whole atlas pixels (default Size/4, minimum 2). Ignored for Bitmap."
               Category="ContentPipeline"
               MinValue="1" />

  <StringProperty Name="PxRangeOffset"
                  DisplayName="Px Range Offset"
                  Description="Shifts the distance range outward (+) or inward (-) from the glyph edge, in atlas pixels (default 0). Must be within +/- PxRange/2."
                  Category="ContentPipeline" />

  <BoolProperty Name="Kerning"
                DisplayName="Kerning"
                Description="Include kerning pairs from the font's GPOS / kern tables (default false)."
                Category="ContentPipeline" />

  <BoolProperty Name="Preload"
                DisplayName="Preload"
                Description="Whether the game needs this before its first frame (default false). On the web, the page starts downloading it at once, alongside the game's code; elsewhere content is read from the app, so it changes nothing."
                Category="ContentPipeline" />

  <StringProperty Name="Identity" Visible="false" ReadOnly="true" Category="Misc"
                  Description="The item specified in the Include attribute.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SpriteFontContent" PersistedName="Identity" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="FullPath" DisplayName="Full Path" ReadOnly="true" Category="Misc"
                  Description="Location of the file.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SpriteFontContent" PersistedName="FullPath" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="FileNameAndExtension" DisplayName="File Name" ReadOnly="true" Category="Misc"
                  Description="Name of the file or folder.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SpriteFontContent" PersistedName="FileNameAndExtension" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="Extension" Visible="false" ReadOnly="true">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SpriteFontContent" PersistedName="Extension" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="URL" ReadOnly="true" Visible="false">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SpriteFontContent" PersistedName="FullPath" />
    </StringProperty.DataSource>
  </StringProperty>

  <BoolProperty Name="Visible" Visible="false" />

  <StringProperty Name="DependentUpon" Visible="false">
    <StringProperty.Metadata>
      <NameValuePair Name="DoNotCopyAcrossProjects" Value="true" />
    </StringProperty.Metadata>
  </StringProperty>

  <StringProperty Name="Link" Visible="false">
    <StringProperty.Metadata>
      <NameValuePair Name="DoNotCopyAcrossProjects" Value="true" />
    </StringProperty.Metadata>
  </StringProperty>

</Rule>
