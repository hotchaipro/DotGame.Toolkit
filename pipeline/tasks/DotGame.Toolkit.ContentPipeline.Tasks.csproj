<Project Sdk="Microsoft.NET.Sdk">

    <!--
        DotGame.Toolkit.ContentPipeline.Tasks: the MSBuild tasks of the
        toolkit content pipeline (ToolkitContentPipelineTasks.cs), compiled once
        rather than as inline RoslynCodeTaskFactory tasks, which recompiled every
        task on every build.

        ..\ContentPipeline.Toolkit.targets registers it with the framework
        pipeline's on-demand build ($(DotGameFrameworkDir)pipeline\
        ContentPipeline.Tasks.targets), which builds it into
        bin\<hash of its sources>\.  Keep the tasks in
        ToolkitContentPipelineTasks.cs: that file and this one are what the hash
        covers.

        netstandard2.0, against the MSBuild packages' reference assemblies (MSBuild
        itself supplies them at run time), so the same assembly loads in dotnet
        build and in Visual Studio's MSBuild.
    -->

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Ported from inline tasks: the repository's code style and analysis rules don't apply -->
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <AnalysisLevel>none</AnalysisLevel>
        <!-- Inline task fragments end in returns of their own (CS0162) -->
        <NoWarn>$(NoWarn);CS0162</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="$(MicrosoftBuildUtilitiesCoreVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

</Project>
