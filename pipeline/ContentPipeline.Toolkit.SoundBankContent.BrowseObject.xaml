<?xml version="1.0" encoding="utf-8"?>
<!--
    Properties pane (browse object) for SoundBankContent items.
    See ContentPipeline.TextureContent.BrowseObject.xaml in the framework
    pipeline for why each rule lives in its own file.
    Registered by ContentPipeline.Toolkit.targets.
-->
<Rule Name="SoundBankContent"
      DisplayName="Sound Bank Content"
      PageTemplate="generic"
      Description="Sound file concatenated into a sound bank by the content pipeline."
      xmlns="http://schemas.microsoft.com/build/2009/properties">

  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" HasConfigurationCondition="False" ItemType="SoundBankContent" />
  </Rule.DataSource>

  <Rule.Categories>
    <Category Name="ContentPipeline" DisplayName="Content Pipeline" />
    <Category Name="Advanced" DisplayName="Advanced" />
    <Category Name="Misc" DisplayName="Misc" />
  </Rule.Categories>

  <DynamicEnumProperty Name="{}{ItemType}"
                       DisplayName="Build Action"
                       Category="Advanced"
                       Description="How the file relates to the build and deployment processes."
                       EnumProvider="ItemTypes" />

  <StringProperty Name="Name"
                  DisplayName="Name"
                  Description="The bank's name (default soundbank): the file name of its descriptor (.json) and audio. All items of a folder sharing a name are concatenated into the same bank."
                  Category="ContentPipeline" />

  <EnumProperty Name="Compression"
                DisplayName="Compression"
                Description="Selects the audio codec used for the bank: Lossless (default) or Lossy (LossyQuality-controlled)."
                Category="ContentPipeline">
    <EnumValue Name="Lossless" DisplayName="Lossless" IsDefault="true" />
    <EnumValue Name="Lossy" DisplayName="Lossy" />
  </EnumProperty>

  <IntProperty Name="LossyQuality"
               DisplayName="Lossy Quality"
               Description="Quality scale 1..10 (default 8) used by Lossy compression. Ignored when Compression=Lossless."
               Category="ContentPipeline"
               MinValue="1"
               MaxValue="10" />

  <EnumProperty Name="LosslessFormat"
                DisplayName="Lossless Format"
                Description="FLAC (Default): about half the download, decoded as it loads, or WAV, read as it is. Ignored when Compression=Lossy."
                Category="ContentPipeline">
    <EnumValue Name="Default" DisplayName="Default" IsDefault="true" />
    <EnumValue Name="WAV" DisplayName="WAV" />
    <EnumValue Name="FLAC" DisplayName="FLAC" />
  </EnumProperty>

  <EnumProperty Name="LossyFormat"
                DisplayName="Lossy Format"
                Description="The platform's own lossy format (default: Opus on the web, desktop and Android, AAC on iOS), or Opus on every platform: smaller than AAC, but iOS decodes it with more CPU. Ignored when Compression=Lossless."
                Category="ContentPipeline">
    <EnumValue Name="Default" DisplayName="Default" IsDefault="true" />
    <EnumValue Name="Opus" DisplayName="Opus" />
  </EnumProperty>

  <BoolProperty Name="Preload"
                DisplayName="Preload"
                Description="Whether the game needs this before its first frame (default false). On the web, the page starts downloading it at once, alongside the game's code; elsewhere content is read from the app, so it changes nothing."
                Category="ContentPipeline" />

  <StringProperty Name="Identity" Visible="false" ReadOnly="true" Category="Misc"
                  Description="The item specified in the Include attribute.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SoundBankContent" PersistedName="Identity" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="FullPath" DisplayName="Full Path" ReadOnly="true" Category="Misc"
                  Description="Location of the file.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SoundBankContent" PersistedName="FullPath" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="FileNameAndExtension" DisplayName="File Name" ReadOnly="true" Category="Misc"
                  Description="Name of the file or folder.">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SoundBankContent" PersistedName="FileNameAndExtension" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="Extension" Visible="false" ReadOnly="true">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SoundBankContent" PersistedName="Extension" />
    </StringProperty.DataSource>
  </StringProperty>

  <StringProperty Name="URL" ReadOnly="true" Visible="false">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="SoundBankContent" PersistedName="FullPath" />
    </StringProperty.DataSource>
  </StringProperty>

  <BoolProperty Name="Visible" Visible="false" />

  <StringProperty Name="DependentUpon" Visible="false">
    <StringProperty.Metadata>
      <NameValuePair Name="DoNotCopyAcrossProjects" Value="true" />
    </StringProperty.Metadata>
  </StringProperty>

  <StringProperty Name="Link" Visible="false">
    <StringProperty.Metadata>
      <NameValuePair Name="DoNotCopyAcrossProjects" Value="true" />
    </StringProperty.Metadata>
  </StringProperty>

</Rule>
