<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <RootNamespace>DotGame.Toolkit.Tests</RootNamespace>
        <!-- Allocation tests read GC.GetAllocatedBytesForCurrentThread. A background GC can retire a
                  thread's allocation buffer and count what was left of it as allocated, so a test that
                  allocated nothing fails with up to 8 KB. Blocking GCs count correctly. -->
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="$(XunitV3Version)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\toolkit\DotGame.Toolkit.csproj" />
        <!-- The framework's test platform: real framework objects over fakes, without its internals -->
        <ProjectReference Include="$(DotGameFrameworkDir)test\DotGame.Framework.Testing\DotGame.Framework.Testing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="DotGame.Framework.Testing" />
    </ItemGroup>

    <ItemGroup>
        <!-- What the content pipeline writes sprite fonts with, so the reader is tested against it -->
        <Compile Include="..\..\pipeline\tool\Serialization\PbonWriter.cs" Link="Fonts\PbonWriter.cs" />
    </ItemGroup>

    <!-- The framework's Debug behaviour in a Debug build, as a game's build sets it -->
    <Import Project="$(DotGameFrameworkDir)packaging\build\DotGame.Framework.Switches.targets" Condition="'$(DotGameFrameworkDir)' != '' and '$(_DotGameSwitchesImported)' != 'true'" />
</Project>
